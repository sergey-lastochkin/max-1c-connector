КонецФункции

// Ряд из 1–3 кнопок.
Функция Ряд(Кнопка1, Кнопка2 = Неопределено, Кнопка3 = Неопределено) Экспорт
	Ряд = Новый Массив;
	Ряд.Добавить(Кнопка1);
	Если Кнопка2 <> Неопределено Тогда
		Ряд.Добавить(Кнопка2);
	КонецЕсли;
	Если Кнопка3 <> Неопределено Тогда
		Ряд.Добавить(Кнопка3);
	КонецЕсли;
	Возврат Ряд;
КонецФункции

