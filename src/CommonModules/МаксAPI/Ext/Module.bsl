#Область СлужебныеПроцедурыИФункции

Функция ЗагрузитьФайл(Настройки, ДанныеФайла, Знач ИмяФайла, Знач ТипФайла)
	
	Если ТипЗнч(ДанныеФайла) = Тип("Строка") Тогда
		Двоичные = Новый ДвоичныеДанные(ДанныеФайла);
		Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
			ИмяФайла = Новый Файл(ДанныеФайла).Имя;
		КонецЕсли;
	Иначе
		Двоичные = ДанныеФайла;
	КонецЕсли;
	
	// 1. URL для загрузки
	Шаг1 = ВыполнитьЗапрос(Настройки, "POST", "/uploads", Новый Структура("type", ТипФайла));
	Если Не Шаг1.Успех Тогда
		Возврат Шаг1;
	КонецЕсли;
	URLЗагрузки = Шаг1.Данные.url;
	ТокенИзШага1 = ?(Шаг1.Данные.Свойство("token"), Шаг1.Данные.token, "");
	
	// 2. Multipart upload
	Граница = "----max1c" + СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	Поток = Новый ПотокВПамяти;
	Запись = Новый ЗаписьДанных(Поток, КодировкаТекста.UTF8, , Символы.ВК + Символы.ПС, , Ложь);
	Запись.ЗаписатьСтроку("--" + Граница);
	Запись.ЗаписатьСтроку("Content-Disposition: form-data; name=""data""; filename=""" + ИмяФайла + """");
	Запись.ЗаписатьСтроку("Content-Type: application/octet-stream");
	Запись.ЗаписатьСтроку("");
	Запись.Записать(Двоичные);
	Запись.ЗаписатьСтроку("");
	Запись.ЗаписатьСтроку("--" + Граница + "--");
	Запись.Закрыть();
	
	СтруктураURL = РазобратьURL(URLЗагрузки);
	Соединение = Новое_Соединение(СтруктураURL.Хост, Настройки.Таймаут * 4);
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Authorization", Настройки.Токен);
	Заголовки.Вставить("Content-Type", "multipart/form-data; boundary=" + Граница);
	Запрос = Новый HTTPЗапрос(СтруктураURL.Путь, Заголовки);
	Запрос.УстановитьТелоИзДвоичныхДанных(Поток.ЗакрытьИПолучитьДвоичныеДанные());
	
	Результат = НовыйРезультат();
	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Журнал(Настройки, "upload", Результат.ТекстОшибки);
		Возврат Результат;
	КонецПопытки;
	
	Результат.КодСостояния = Ответ.КодСостояния;
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если Ответ.КодСостояния <> 200 Тогда
		Результат.ТекстОшибки = "upload: HTTP " + Ответ.КодСостояния + " " + Лев(ТелоОтвета, 500);
		Журнал(Настройки, "upload", Результат.ТекстОшибки);
		Возврат Результат;
	КонецЕсли;
	
	// для file/image токен приходит в ответе загрузки, для audio/video — на шаге 1
	ДанныеОтвета = ПрочитатьJSONБезопасно(ТелоОтвета);
	Если ТипЗнч(ДанныеОтвета) = Тип("Структура") И ДанныеОтвета.Количество() > 0 И Не ДанныеОтвета.Свойство("raw") Тогда
		Результат.Данные = ДанныеОтвета;
	Иначе
		Результат.Данные = Новый Структура("token", ТокенИзШага1);
	КонецЕсли;
	Результат.Успех = Истина;
	Возврат Результат;
	
КонецФункции

Функция ВложениеПоТокену(Знач ТипВложения, ДанныеЗагрузки)
	
	Если ТипВложения = "image" И ДанныеЗагрузки.Свойство("photos") Тогда
		Полезная = Новый Структура("photos", ДанныеЗагрузки.photos);
	ИначеЕсли ДанныеЗагрузки.Свойство("token") Тогда
		Полезная = Новый Структура("token", ДанныеЗагрузки.token);
	Иначе
		Полезная = ДанныеЗагрузки;
	КонецЕсли;
	Возврат Новый Структура("type, payload", ТипВложения, Полезная);
	
КонецФункции

// Единая точка HTTP: ретраи на 429 / 5xx / attachment.not.ready с экспоненциальной паузой.
Функция ВыполнитьЗапрос(Настройки, Знач Метод, Знач Путь, ПараметрыURL = Неопределено, Тело = Неопределено)
	
	Результат = НовыйРезультат();
	Если Не ЗначениеЗаполнено(Настройки.Токен) Тогда
		Результат.ТекстОшибки = "Не задан токен бота MAX";
		Возврат Результат;
	КонецЕсли;
	
	ПолныйПуть = Путь + СтрокаПараметров(ПараметрыURL);
	ТелоJSON = ?(Тело = Неопределено, "", ЗаписатьJSONВСтроку(Тело));
	ПаузаМс = 700;
	
	Для НомерПопытки = 1 По Настройки.МаксПопыток Цикл
		
		Заголовки = Новый Соответствие;
		Заголовки.Вставить("Authorization", Настройки.Токен);
		Заголовки.Вставить("Accept", "application/json");
		Если ЗначениеЗаполнено(ТелоJSON) Тогда
			Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		КонецЕсли;
		Запрос = Новый HTTPЗапрос(ПолныйПуть, Заголовки);
		Если ЗначениеЗаполнено(ТелоJSON) Тогда
			Запрос.УстановитьТелоИзСтроки(ТелоJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
		КонецЕсли;
		
		Попытка
			Соединение = Новое_Соединение(Настройки.Сервер, Настройки.Таймаут);
			Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
		Исключение
			Результат.ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			Пауза(ПаузаМс);
			ПаузаМс = ПаузаМс * 2;
			Продолжить;
		КонецПопытки;
		
		Результат.КодСостояния = Ответ.КодСостояния;
		ТекстОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Данные = ПрочитатьJSONБезопасно(ТекстОтвета);
		Результат.Данные = Данные;
		
		КодОшибки = "";
		Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("code") Тогда
			КодОшибки = Строка(Данные.code);
		КонецЕсли;
		// часть методов отдаёт 200 + success=false
		ЛожныйУспех = ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("success") И Данные.success = Ложь;
		
		Если Ответ.КодСостояния = 200 И Не ЛожныйУспех Тогда
			Результат.Успех = Истина;
			Результат.КодОшибки = "";
			Результат.ТекстОшибки = "";
			Возврат Результат;
		КонецЕсли;
		
		Результат.КодОшибки = КодОшибки;
		Результат.ТекстОшибки = "HTTP " + Ответ.КодСостояния + " " + КодОшибки + " " + Лев(ТекстОтвета, 500);
		
		Повторять = Ответ.КодСостояния = 429 Или Ответ.КодСостояния >= 500
			Или КодОшибки = "attachment.not.ready";
		Если Не Повторять Тогда
			Журнал(Настройки, ПолныйПуть, Результат.ТекстОшибки);
			Возврат Результат;
		КонецЕсли;
		
		Пауза(ПаузаМс);
		ПаузаМс = ПаузаМс * 2;
		
	КонецЦикла;
	
	Журнал(Настройки, ПолныйПуть, Результат.ТекстОшибки);
	Возврат Результат;
	
КонецФункции

Функция НовыйРезультат()
	Возврат Новый Структура("Успех, КодСостояния, КодОшибки, ТекстОшибки, Данные", Ложь, 0, "", "", Неопределено);
КонецФункции

Функция Новое_Соединение(Знач Хост, Знач Таймаут)
	Возврат Новый HTTPСоединение(Хост, 443, , , , Таймаут, Новый ЗащищенноеСоединениеOpenSSL);
КонецФункции

Функция ПараметрыПолучателя(Получатель)
	Если ТипЗнч(Получатель) <> Тип("Структура") Тогда
		ВызватьИсключение "МаксAPI: получатель задаётся через ПолучательПользователь() или ПолучательЧат()";
	КонецЕсли;
	Параметры = Новый Структура;
	Параметры.Вставить(Получатель.Тип, Формат(Получатель.ИД, "ЧГ="));
	Возврат Параметры;
КонецФункции

Функция СтрокаПараметров(ПараметрыURL)
	Если ПараметрыURL = Неопределено Или ПараметрыURL.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Для Каждого КлючЗначение Из ПараметрыURL Цикл
		Части.Добавить(КлючЗначение.Ключ + "=" + КодироватьСтроку(Строка(КлючЗначение.Значение), СпособКодированияСтроки.КодировкаURL));
	КонецЦикла;
	Возврат "?" + СтрСоединить(Части, "&");
КонецФункции

Функция РазобратьURL(Знач URL)
	БезСхемы = СтрЗаменить(СтрЗаменить(URL, "https://", ""), "http://", "");
	Позиция = СтрНайти(БезСхемы, "/");
	Если Позиция = 0 Тогда
		Возврат Новый Структура("Хост, Путь", БезСхемы, "/");
	КонецЕсли;
	Возврат Новый Структура("Хост, Путь", Лев(БезСхемы, Позиция - 1), Сред(БезСхемы, Позиция));
КонецФункции

Функция РазбитьТекст(Знач Текст, Знач Лимит)
	Части = Новый Массив;
	Текст = Строка(Текст);
	Пока СтрДлина(Текст) > Лимит Цикл
		Кусок = Лев(Текст, Лимит);
		Разрыв = СтрНайти(Кусок, Символы.ПС, НаправлениеПоиска.СКонца);
		Если Разрыв < Лимит / 2 Тогда
			Разрыв = Лимит;
		КонецЕсли;
		Части.Добавить(Лев(Текст, Разрыв));
		Текст = Сред(Текст, Разрыв + 1);
	КонецЦикла;
	Части.Добавить(Текст);
	Возврат Части;
КонецФункции

Функция ИДСообщения(Сообщение)
	Если ТипЗнч(Сообщение) = Тип("Структура") И Сообщение.Свойство("body")
		И ТипЗнч(Сообщение.body) = Тип("Структура") И Сообщение.body.Свойство("mid") Тогда
		Возврат Строка(Сообщение.body.mid);
	КонецЕсли;
	Возврат "";
КонецФункции

Функция ЗаписатьJSONВСтроку(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ПрочитатьJSONБезопасно(Знач Текст)
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Новый Структура;
	КонецЕсли;
	Попытка
		Чтение = Новый ЧтениеJSON;
		Чтение.УстановитьСтроку(Текст);
		Возврат ПрочитатьJSON(Чтение, Ложь);
	Исключение
		Возврат Новый Структура("raw", Текст);
	КонецПопытки;
КонецФункции

Функция СкопироватьНастройки(Настройки)
	Копия = Новый Структура;
	Для Каждого КлючЗначение Из Настройки Цикл
		Копия.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
	КонецЦикла;
	Возврат Копия;
КонецФункции

// В 1С нет Sleep на сервере; короткие паузы (до нескольких секунд) — ожиданием по таймеру.
Процедура Пауза(Знач Миллисекунды)
	Конец = ТекущаяУниверсальнаяДатаВМиллисекундах() + Миллисекунды;
	Пока ТекущаяУниверсальнаяДатаВМиллисекундах() < Конец Цикл
	КонецЦикла;
КонецПроцедуры

Процедура Журнал(Настройки, Знач Метод, Знач Текст)
	Если Настройки.Журналировать Тогда
		ЗаписьЖурналаРегистрации("MAX.API", УровеньЖурналаРегистрации.Ошибка, , Метод, Текст);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
