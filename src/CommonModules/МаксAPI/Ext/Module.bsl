#Область ПрограммныйИнтерфейс

// Создаёт структуру настроек подключения.
//
// Параметры:
//   Токен - Строка - токен бота из «MAX для бизнеса» → Чат-боты → Настройки.
//
// Возвращаемое значение:
//   Структура - настройки, передаются во все методы модуля.
//
Функция НовыеНастройки(Знач Токен) Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("Токен", СокрЛП(Токен));
	Настройки.Вставить("Сервер", "platform-api2.max.ru");
	Настройки.Вставить("Таймаут", 30);
	Настройки.Вставить("МаксПопыток", 4);
	Настройки.Вставить("ПаузаМеждуСообщениямиМс", 550); // лимит MAX: 2 сообщения/сек в один чат
	Настройки.Вставить("Журналировать", Истина);
	Возврат Настройки;
	
КонецФункции

// Проверяет токен (GET /me).
Функция ПроверитьПодключение(Настройки) Экспорт
	Возврат ВыполнитьЗапрос(Настройки, "GET", "/me");
КонецФункции

// Отправляет текстовое сообщение пользователю или в чат/канал.
//
// Параметры:
//   Настройки  - Структура - см. НовыеНастройки().
//   Получатель - Структура - см. ПолучательПользователь() / ПолучательЧат().
//   Текст      - Строка - длинный текст режется на части по 4000 символов.
//   Вложения   - Массив, Структура, Неопределено - вложения (см. Клавиатура()).
//   Формат     - Строка - "markdown", "html" или "".
//   Уведомлять - Булево - push-уведомление получателю.
//
Функция ОтправитьСообщение(Настройки, Получатель, Знач Текст, Вложения = Неопределено,
	Знач Формат = "markdown", Знач Уведомлять = Истина) Экспорт
	
	Если ТипЗнч(Вложения) = Тип("Структура") Тогда
		Одно = Вложения;
		Вложения = Новый Массив;
		Вложения.Добавить(Одно);
	КонецЕсли;
	
	Части = РазбитьТекст(Текст, 4000);
	Результат = Неопределено;
	
	Для Индекс = 0 По Части.ВГраница() Цикл
		
		Тело = Новый Структура;
		Тело.Вставить("text", Части[Индекс]);
		Тело.Вставить("notify", Уведомлять);
		Если ЗначениеЗаполнено(Формат) Тогда
			Тело.Вставить("format", Формат);
		КонецЕсли;
		Если Индекс = Части.ВГраница() И ЗначениеЗаполнено(Вложения) Тогда
			Тело.Вставить("attachments", Вложения);
		КонецЕсли;
		
		Результат = ВыполнитьЗапрос(Настройки, "POST", "/messages", ПараметрыПолучателя(Получатель), Тело);
		Если Не Результат.Успех Тогда
			Возврат Результат;
		КонецЕсли;
		
		Если Индекс < Части.ВГраница() Тогда
			Пауза(Настройки.ПаузаМеждуСообщениямиМс);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Отправляет файл (PDF квитанции, акт сверки, XLSX) с подписью.
//
// Параметры:
//   ДанныеФайла - ДвоичныеДанные, Строка - данные или полный путь к файлу.
//   ИмяФайла    - Строка - имя для получателя, например "Акт сверки.pdf".
//   Подпись     - Строка - текст сообщения к файлу.
//   Кнопки      - Структура, Неопределено - см. Клавиатура().
//
Функция ОтправитьФайл(Настройки, Получатель, ДанныеФайла, Знач ИмяФайла, Знач Подпись = "",
	Кнопки = Неопределено) Экспорт
	
	Загрузка = ЗагрузитьФайл(Настройки, ДанныеФайла, ИмяФайла, "file");
	Если Не Загрузка.Успех Тогда
		Возврат Загрузка;
	КонецЕсли;
	
	Вложения = Новый Массив;
	Вложения.Добавить(ВложениеПоТокену("file", Загрузка.Данные));
	Если Кнопки <> Неопределено Тогда
		Вложения.Добавить(Кнопки);
	КонецЕсли;
	
	// файл обрабатывается не мгновенно: ретраи на attachment.not.ready внутри ВыполнитьЗапрос
	Возврат ОтправитьСообщение(Настройки, Получатель, Подпись, Вложения);
	
КонецФункции

// Отправляет картинку (график, фото, скан).
Функция ОтправитьИзображение(Настройки, Получатель, ДанныеФайла, Знач ИмяФайла, Знач Подпись = "") Экспорт
	
	Загрузка = ЗагрузитьФайл(Настройки, ДанныеФайла, ИмяФайла, "image");
	Если Не Загрузка.Успех Тогда
		Возврат Загрузка;
	КонецЕсли;
	
	Вложения = Новый Массив;
	Вложения.Добавить(ВложениеПоТокену("image", Загрузка.Данные));
	Возврат ОтправитьСообщение(Настройки, Получатель, Подпись, Вложения);
	
КонецФункции

// Рассылка по списку получателей с соблюдением лимитов.
//
// Параметры:
//   Получатели - Массив из Структура - см. ПолучательПользователь().
//   Текст      - Строка, Массив из Строка - общий текст либо персональный по индексу.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Получатель, Успех, КодОшибки, Сообщение, ИДСообщения.
//
Функция Рассылка(Настройки, Получатели, Текст, Вложения = Неопределено) Экспорт
	
	Отчет = Новый ТаблицаЗначений;
	Отчет.Колонки.Добавить("Получатель");
	Отчет.Колонки.Добавить("Успех", Новый ОписаниеТипов("Булево"));
	Отчет.Колонки.Добавить("КодОшибки", Новый ОписаниеТипов("Строка"));
	Отчет.Колонки.Добавить("Сообщение", Новый ОписаниеТипов("Строка"));
	Отчет.Колонки.Добавить("ИДСообщения", Новый ОписаниеТипов("Строка"));
	
	Для Индекс = 0 По Получатели.ВГраница() Цикл
		
		ТекстПолучателя = ?(ТипЗнч(Текст) = Тип("Массив"), Текст[Индекс], Текст);
		Результат = ОтправитьСообщение(Настройки, Получатели[Индекс], ТекстПолучателя, Вложения);
		
		Строка = Отчет.Добавить();
		Строка.Получатель = Получатели[Индекс];
		Строка.Успех = Результат.Успех;
		Строка.КодОшибки = Результат.КодОшибки;
		Строка.Сообщение = Результат.ТекстОшибки;
		Если Результат.Успех И ТипЗнч(Результат.Данные) = Тип("Структура")
			И Результат.Данные.Свойство("message") Тогда
			Строка.ИДСообщения = ИДСообщения(Результат.Данные.message);
		КонецЕсли;
		
		// общий лимит API — 30 rps; держим запас
		Пауза(50);
		
	КонецЦикла;
	
	Возврат Отчет;
	
КонецФункции

// Получает входящие события через Long Polling (GET /updates).
// Для регламентного задания: храните Маркер между вызовами.
//
// Возвращаемое значение:
//   Структура - Успех, События (Массив), Маркер (Число), ТекстОшибки.
//
Функция ПолучитьСобытия(Настройки, Знач Маркер = Неопределено, Знач ТаймаутСек = 25,
	Знач Типы = "message_created,message_callback,bot_started") Экспорт
	
	Параметры = Новый Структура;
	Параметры.Вставить("timeout", Формат(ТаймаутСек, "ЧГ="));
	Параметры.Вставить("limit", "100");
	Если ЗначениеЗаполнено(Маркер) Тогда
		Параметры.Вставить("marker", Формат(Маркер, "ЧГ="));
	КонецЕсли;
	Если ЗначениеЗаполнено(Типы) Тогда
		Параметры.Вставить("types", Типы);
	КонецЕсли;
	
	НастройкиЗапроса = СкопироватьНастройки(Настройки);
	НастройкиЗапроса.Таймаут = ТаймаутСек + 10;
	Результат = ВыполнитьЗапрос(НастройкиЗапроса, "GET", "/updates", Параметры);
	
	Ответ = Новый Структура("Успех, События, Маркер, ТекстОшибки", Результат.Успех, Новый Массив, Маркер, Результат.ТекстОшибки);
	Если Результат.Успех И ТипЗнч(Результат.Данные) = Тип("Структура") Тогда
		Если Результат.Данные.Свойство("updates") Тогда
			Ответ.События = Результат.Данные.updates;
		КонецЕсли;
		Если Результат.Данные.Свойство("marker") И Результат.Данные.marker <> Null Тогда
			Ответ.Маркер = Результат.Данные.marker;
		КонецЕсли;
	КонецЕсли;
	Возврат Ответ;
	
КонецФункции

// Отвечает на нажатие callback-кнопки (POST /answers).
Функция ОтветитьНаНажатие(Настройки, Знач ИДНажатия, Знач Уведомление = "", НовоеСообщение = Неопределено) Экспорт
	
	Тело = Новый Структура;
	Если ЗначениеЗаполнено(Уведомление) Тогда
		Тело.Вставить("notification", Уведомление);
	КонецЕсли;
	Если НовоеСообщение <> Неопределено Тогда
		Тело.Вставить("message", НовоеСообщение);
	КонецЕсли;
	Возврат ВыполнитьЗапрос(Настройки, "POST", "/answers", Новый Структура("callback_id", ИДНажатия), Тело);
	
КонецФункции

