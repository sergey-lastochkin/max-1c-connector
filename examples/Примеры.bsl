// Примеры использования МаксAPI. Вставляйте в обработку / регламентное задание.

// 1. Проверка токена
Настройки = МаксAPI.НовыеНастройки(Константы.ТокенБотаMAX.Получить());
Проверка = МаксAPI.ПроверитьПодключение(Настройки);
Сообщить(?(Проверка.Успех, "Бот: " + Проверка.Данные.name, Проверка.ТекстОшибки));

// 2. Сообщение с кнопками
Ряды = Новый Массив;
Ряды.Добавить(МаксAPI.Ряд(МаксAPI.КнопкаСсылка("Оплатить", "https://pay.example.ru/12345")));
Ряды.Добавить(МаксAPI.Ряд(МаксAPI.КнопкаДействие("Акт сверки", "akt:12345")));
МаксAPI.ОтправитьСообщение(Настройки, МаксAPI.ПолучательПользователь(123456789),
	"**Задолженность на 01.12:** 4 815,20 ₽", МаксAPI.Клавиатура(Ряды));

// 3. PDF акта сверки из печатной формы
ТабДок = ПолучитьАктСверки(Контрагент); // ваша функция, возвращает ТабличныйДокумент
ИмяВременного = ПолучитьИмяВременногоФайла("pdf");
ТабДок.Записать(ИмяВременного, ТипФайлаТабличногоДокумента.PDF);
Результат = МаксAPI.ОтправитьФайл(Настройки, МаксAPI.ПолучательЧат(-70000000000001),
	ИмяВременного, "Акт сверки.pdf", "Акт сверки за 2025 год");
УдалитьФайлы(ИмяВременного);

// 4. Рассылка должникам
Получатели = Новый Массив;
Тексты = Новый Массив;
Для Каждого СтрокаДолжника Из ТаблицаДолжников Цикл // ИДMAX, ЛицевойСчет, Сумма
	Получатели.Добавить(МаксAPI.ПолучательПользователь(СтрокаДолжника.ИДMAX));
	Тексты.Добавить(СтрШаблон("Л/с %1: долг %2 ₽. Оплатите до 10 числа.",
		СтрокаДолжника.ЛицевойСчет, Формат(СтрокаДолжника.Сумма, "ЧДЦ=2")));
КонецЦикла;
Отчет = МаксAPI.Рассылка(Настройки, Получатели, Тексты);

// 5. Регламентное задание: приём событий (раз в минуту)
Ответ = МаксAPI.ПолучитьСобытия(Настройки, Константы.МаркерMAX.Получить(), 25);
Для Каждого Событие Из Ответ.События Цикл
	Если Событие.update_type = "message_callback" Тогда
		ДанныеКнопки = Событие.callback.payload; // "akt:12345"
		МаксAPI.ОтветитьНаНажатие(Настройки, Событие.callback.callback_id, "Готовлю акт…");
		// ... сформировать и отправить файл
	ИначеЕсли Событие.update_type = "message_created" Тогда
		// Событие.message.sender.user_id, Событие.message.body.text
	КонецЕсли;
КонецЦикла;
Константы.МаркерMAX.Установить(Ответ.Маркер);
